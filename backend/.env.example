# ---------------------------------------------------------------------------
# Legal Metrology Compliance System — environment template
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- MongoDB Atlas -----------------------------------------------------------
# Required. The app refuses to start without it (no baked-in fallback).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=legal_metrology_db

# --- Security ----------------------------------------------------------------
# Required. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin account, seeded on startup if the users collection is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@legalmetrology.gov.in
BOOTSTRAP_ADMIN_PASSWORD=

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist. Wildcards are rejected when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: Vision Language Model pass ------------------------------------
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
